{
  "network": "sioux_falls",
  "tap_backend": "fast",
  "seed": 42,
  "run_name": "exp0/sf20_ppo_curriculum",
  "instance": "instances/instance_sf20.json",
  "training": {
    "time_budget": 86400,
    "n_episodes": 10000,
    "eval_interval": 1000,
    "n_eval_episodes": 50,
    "n_workers": 16,
    "curriculum_phase0_episodes": 500,
    "curriculum_phase0_mode": "bc",
    "curriculum_phase1_plateau_window": 5,
    "curriculum_phase1_plateau_tol": 0.01,
    "curriculum_reset_critic": false,
    "curriculum_additive_travel": true,
    "curriculum_phase_budget_frac": 0.5,
    "curriculum_phase1_max_episodes": 0,
    "curriculum_heuristic": {
      "agent_type": "valuedensity",
      "extra": {
        "max_concurrent": 2,
        "risk_weight": 0.7821108030731895,
        "degrad_weight": 1.6328084276098718,
        "threshold": 0.7158196036788849
      }
    }
  },
  "agent": {
    "agent_type": "ppo",
    "extra": {
      "hidden_dims": [
        64,
        64
      ],
      "ppo_kwargs": {
        "actor_lr": 0.0003,
        "critic_lr": 0.001,
        "clip_eps": 0.2,
        "entropy_coef": 0.02,
        "value_coef": 0.5,
        "gae_lambda": 0.95,
        "ppo_epochs": 4,
        "mini_batch_size": 64
      }
    }
  }
}
